\frametitle{Backend FastAPI}
\begin{columns}[T,onlytextwidth]
    \column{0.50\textwidth}
      \begin{block}{\codefile{src/main.py}}
      Carga el índice y expone los endpoints que consume Flutter.
      \end{block}
      \begin{table}
      \centering
      \scriptsize
      \begin{tabular}{ll}
      \toprule
      Endpoint & Función \\
      \midrule
      \codefile{GET /health} & comprobar estado \\
      \codefile{POST /query} & buscar Top-K \\
      \codefile{GET /images/...} & servir imágenes \\
      \codefile{GET /} & servir web compilada \\
      \bottomrule
      \end{tabular}
      \end{table}
    \column{0.46\textwidth}
      \begin{lstlisting}
POST /query?topk=10
Content-Type: multipart/form-data
field: image
      \end{lstlisting}
      \begin{itemize}
        \item Respuesta en JSON.
        \item Incluye metadatos físicos y sustancias.
        \item Construye URLs para mostrar imágenes en la app.
      \end{itemize}
  \end{columns}

