<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#1A1A24"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="#2A2A3A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#12121A"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/rankText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#7EB8F7"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="#1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/scoreBar"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/score_bar_bg"
                    tools:layout_width="100dp" />

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="95%" />
            </LinearLayout>
        </LinearLayout>

        <!-- Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Image placeholder -->
            <ImageView
                android:id="@+id/pillImage"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/image_placeholder_bg"
                android:scaleType="centerCrop"
                tools:src="@drawable/pill_placeholder" />

            <!-- Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Metadata grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Color"
                            android:textColor="#555555"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/colorText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#DDDDDD"
                            android:textSize="13sp"
                            tools:text="Naranja" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Logo"
                            android:textColor="#555555"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/logoText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#DDDDDD"
                            android:textSize="13sp"
                            tools:text="SoundCloud" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Origin"
                            android:textColor="#555555"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/procedenciaText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#DDDDDD"
                            android:textSize="13sp"
                            tools:text="Barcelona" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textColor="#555555"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/fechaText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#DDDDDD"
                            android:textSize="13sp"
                            tools:text="2021-07-20" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Weight"
                            android:textColor="#555555"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/pesoText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#DDDDDD"
                            android:textSize="13sp"
                            tools:text="463 mg" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Diameter"
                            android:textColor="#555555"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/diametroText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#DDDDDD"
                            android:textSize="13sp"
                            tools:text="14 mm" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- Sustancias section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMPOSITION"
                android:textColor="#666666"
                android:textSize="10sp"
                android:letterSpacing="0.05" />

            <LinearLayout
                android:id="@+id/sustanciasContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
